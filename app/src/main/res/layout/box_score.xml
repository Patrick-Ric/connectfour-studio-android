<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/score_box"
    style="@style/Box"
    android:background="@drawable/box_bg_clickable">

    <TextView
        android:id="@+id/score_title"
        style="@style/BoxTitle" />

    <TextView
        android:id="@+id/stand_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/stand_big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textColor="@color/text_main"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/stand_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/stand_elo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <!-- Real buttons (not borderless): they must look like buttons. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:ignore="ButtonStyle">

        <Button
            android:id="@+id/stand_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/stand_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
