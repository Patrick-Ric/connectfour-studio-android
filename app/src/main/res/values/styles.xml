<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light/dark parents: values-night/styles.xml redefines the two Base styles. -->
    <style name="BaseTheme" parent="android:Theme.Material.Light.DarkActionBar" />

    <style name="BaseAlert" parent="android:Theme.Material.Light.Dialog.Alert" />

    <style name="AppTheme" parent="BaseTheme">
        <item name="android:colorPrimary">@color/bar_bg</item>
        <item name="android:colorPrimaryDark">@color/bar_bg_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:alertDialogTheme">@style/AlertTheme</item>
        <item name="android:buttonStyle">@style/FlatButton</item>
    </style>

    <style name="AlertTheme" parent="BaseAlert">
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- All buttons: flat, rounded, no shadow (old look: just remove buttonStyle above). -->
    <style name="FlatButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!-- Card (desktop: QGroupBox) -->
    <style name="Box">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/box_bg</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="BoxTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/help_head</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="InfoLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="InfoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="PswField">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">3</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="MatchButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
